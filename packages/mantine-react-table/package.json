{
  "version": "10.0.1",
  "license": "MIT",
  "name": "@uponu-solutions/mantine-react-table",
  "description": "A fully featured Mantine implementation of TanStack React Table V9, written from the ground up in TypeScript.",
  "author": "Kevin Vandy",
  "keywords": [
    "react-table",
    "mantine",
    "tanstack table",
    "data table",
    "data grid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uponusolutions/mantine-react-table"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kevinvandy"
  },
  "homepage": "https://www.mantine-react-table.com/",
  "bugs": {
    "url": "https://github.com/uponusolutions/mantine-react-table/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.esm.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.mts",
        "default": "./dist/index.esm.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./locales/*": {
      "import": {
        "types": "./locales/*/index.esm.d.mts",
        "default": "./locales/*/index.esm.mjs"
      },
      "require": {
        "types": "./locales/*/index.d.cts",
        "default": "./locales/*/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "locales",
    "styles.css",
    "src"
  ],
  "size-limit": [
    {
      "path": "dist/index.cjs",
      "limit": "68 KB"
    },
    {
      "path": "dist/index.esm.mjs",
      "limit": "61 KB"
    }
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm lib:build",
    "build-locales": "pnpm lib:build-locales",
    "build-lib": "pnpm lib:build-lib",
    "dev": "pnpm lib:dev",
    "lib:build": "pnpm build-lib && pnpm build-locales",
    "lib:build-locales": "node build-locales.mjs",
    "lib:build-lib": "rm -rf dist && rollup -c rollup.config.mjs && size-limit",
    "lib:dev": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint .",
    "size": "size-limit",
    "storybook": "pnpm storybook:dev",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6007"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@faker-js/faker": "^10.6.0",
    "@mantine/core": "9.7.2",
    "@mantine/dates": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tabler/icons-react": "3.49.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "mantine-contextmenu": "^9.4.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "rollup": "^4.64.5",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "size-limit": "^14.2.0",
    "storybook": "^10.6.1",
    "storybook-dark-mode": "^5.0.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.15"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@tabler/icons-react": ">=2.23.0",
    "clsx": ">=2",
    "dayjs": ">=1.11",
    "react": ">=19.2",
    "react-dom": ">=19.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
